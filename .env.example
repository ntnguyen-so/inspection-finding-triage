# Reference only: the library does not automatically load this file.
# Supply secrets through your process environment or secret manager, never Git.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR-KEY
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
# Optional comparison metadata; these do not select the deployed model.
AZURE_OPENAI_MODEL_NAME=
AZURE_OPENAI_MODEL_VERSION=
# Explicit --azure-auth entra uses DefaultAzureCredential instead of the API key.
# Azure GA /openai/v1/ does not use AZURE_OPENAI_API_VERSION.
